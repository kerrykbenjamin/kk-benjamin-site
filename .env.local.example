# Copy this file to ".env.local" and fill in the values when you're ready to
# turn on editing. Until then the site runs on the local dev fallback + the
# built-in default copy — nothing breaks.

# --- Supabase (Settings → API in your Supabase project) ---------------------
# Leave BOTH blank to use the local dev store (text -> .content-store/content.json,
# photos -> public/images/uploads). Fill them in to store content in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login ------------------------------------------------------------
# Bcrypt hash of your chosen password. Generate it with:
#   npm run set-password -- "your-password-here"
# then paste the printed line below EXACTLY (it escapes the "$" as "\$" so the
# dotenv loader doesn't mangle the hash — keep the backslashes).
ADMIN_PASSWORD_HASH=

# A long random secret used to sign the login cookie (>= 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Contact form (Web3Forms) ------------------------------------------------
# The "Get in touch" modal delivers messages via Web3Forms (free, no backend).
# Setup (one-time, ~2 minutes):
#   1. Go to https://web3forms.com and enter the destination inbox
#      (kerrybenjamin@gmail.com) — they email you an Access Key.
#   2. Paste that key below. The destination address is bound to the key on
#      Web3Forms' side, so it never appears in the site's code.
#   3. Restart the dev server (or redeploy on Netlify with this env var set).
# Until the key is set the form shows a clear "couldn't send" message instead
# of pretending to succeed.
NEXT_PUBLIC_WEB3FORMS_KEY=
